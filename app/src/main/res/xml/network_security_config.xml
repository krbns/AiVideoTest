<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- Android 7 may lack ISRG Root X1. Supplement only the API host's trust store. -->
    <domain-config>
        <domain includeSubdomains="false">benvilo.shop</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
        </trust-anchors>
    </domain-config>
</network-security-config>
