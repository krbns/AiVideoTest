<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Component-to-token mappings are Android adaptations; see docs/design-system.md. -->
    <style name="ShapeAppearanceOverlay.AiVideoTest.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="Widget.AiVideoTest.TextView" parent="Widget.MaterialComponents.TextView">
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAppearance">@style/TextAppearance.AiVideoTest.Body.Regular</item>
        <item name="android:textColor">@color/ds_label_content</item>
    </style>
    <style name="Widget.AiVideoTest.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAppearance">@style/TextAppearance.AiVideoTest.Headline.Emphasized</item>
        <item name="android:textColor">@color/ds_button_primary_content</item>
        <item name="textAllCaps">false</item>
        <item name="backgroundTint">@color/ds_button_primary_background</item>
        <item name="iconTint">@color/ds_button_primary_content</item>
        <item name="rippleColor">@color/ds_label_primary_inverted_invariably</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.AiVideoTest.Pill</item>
        <item name="android:minHeight">@dimen/ds_button_large_min_height</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="Widget.AiVideoTest.Button.Primary.Medium" parent="Widget.AiVideoTest.Button.Primary">
        <item name="android:minHeight">@dimen/ds_button_medium_min_height</item>
    </style>
    <style name="Widget.AiVideoTest.Button.Primary.Small" parent="Widget.AiVideoTest.Button.Primary">
        <item name="android:minHeight">@dimen/ds_button_small_min_height</item>
    </style>
    <style name="Widget.AiVideoTest.Button.Primary.Compact" parent="Widget.AiVideoTest.Button.Primary">
        <item name="android:minHeight">@dimen/ds_button_compact_min_height</item>
    </style>
    <style name="Widget.AiVideoTest.Button.Secondary" parent="Widget.AiVideoTest.Button.Primary">
        <item name="backgroundTint">@color/ds_accent_grey</item>
        <item name="android:textColor">@color/ds_label_content</item>
        <item name="iconTint">@color/ds_label_content</item>
        <item name="rippleColor">@color/ds_background_quaternary</item>
    </style>
    <style name="Widget.AiVideoTest.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAppearance">@style/TextAppearance.AiVideoTest.Headline.Regular</item>
        <item name="android:textColor">@color/ds_label_content</item>
        <item name="iconTint">@color/ds_label_content</item>
        <item name="textAllCaps">false</item>
        <item name="rippleColor">@color/ds_background_quaternary</item>
    </style>
    <style name="Widget.AiVideoTest.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/ds_background_secondary</item>
        <item name="cardElevation">0dp</item>
        <item name="cardCornerRadius">@dimen/ds_plan_corner_radius</item>
        <item name="strokeColor">@color/ds_separator_primary</item>
        <item name="strokeWidth">@dimen/ds_android_stroke_width</item>
        <item name="rippleColor">@color/ds_background_quaternary</item>
    </style>
    <style name="Widget.AiVideoTest.Card.Selectable" parent="Widget.AiVideoTest.Card">
        <item name="android:checkable">true</item>
        <item name="cardBackgroundColor">@color/ds_card_background</item>
        <item name="strokeColor">@color/ds_card_stroke</item>
        <item name="strokeWidth">@dimen/ds_android_selected_stroke_width</item>
        <item name="checkedIconTint">@color/ds_accent_primary</item>
    </style>
    <style name="Widget.AiVideoTest.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="materialThemeOverlay">@style/ThemeOverlay.AiVideoTest.TextInput</item>
        <item name="boxBackgroundColor">@color/ds_background_primary</item>
        <item name="boxStrokeColor">@color/ds_input_stroke</item>
        <item name="boxStrokeErrorColor">@color/ds_accent_red</item>
        <item name="boxStrokeWidth">@dimen/ds_android_stroke_width</item>
        <item name="boxStrokeWidthFocused">@dimen/ds_android_stroke_width</item>
        <item name="boxCornerRadiusTopStart">@dimen/ds_input_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/ds_input_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/ds_input_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/ds_input_corner_radius</item>
        <item name="hintTextAppearance">@style/TextAppearance.AiVideoTest.Subheadline.Regular</item>
        <item name="android:textColorHint">@color/ds_label_tertiary</item>
        <item name="hintTextColor">@color/ds_label_tertiary</item>
        <item name="errorTextAppearance">@style/TextAppearance.AiVideoTest.Caption1.Regular</item>
        <item name="errorTextColor">@color/ds_accent_red</item>
    </style>
    <style name="ThemeOverlay.AiVideoTest.TextInput" parent="ThemeOverlay.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="editTextStyle">@style/Widget.AiVideoTest.TextInputEditText</item>
    </style>
    <style name="Widget.AiVideoTest.TextInputEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAppearance">@style/TextAppearance.AiVideoTest.Subheadline.Regular</item>
        <item name="android:textColor">@color/ds_label_content</item>
        <item name="android:textColorHint">@color/ds_label_tertiary</item>
    </style>
    <style name="Widget.AiVideoTest.SearchInput" parent="Widget.AiVideoTest.TextInputLayout">
        <item name="boxCornerRadiusTopStart">@dimen/ds_search_corner_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/ds_search_corner_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/ds_search_corner_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/ds_search_corner_radius</item>
        <item name="boxBackgroundColor">@color/ds_background_tertiary</item>
        <item name="hintEnabled">false</item>
    </style>
    <style name="Widget.AiVideoTest.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@color/ds_background_primary</item>
        <item name="itemIconTint">@color/ds_navigation_content</item>
        <item name="itemTextColor">@color/ds_navigation_content</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.AiVideoTest.Caption1.Regular</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.AiVideoTest.Caption1.Regular</item>
        <item name="itemRippleColor">@color/ds_accent_primary_alpha</item>
        <item name="itemHorizontalTranslationEnabled">false</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="Widget.AiVideoTest.TabLayout" parent="Widget.MaterialComponents.TabLayout">
        <item name="android:background">@color/ds_background_primary</item>
        <item name="tabTextAppearance">@style/TextAppearance.AiVideoTest.Subheadline.Regular</item>
        <item name="tabTextColor">@color/ds_navigation_content</item>
        <item name="tabIconTint">@color/ds_navigation_content</item>
        <item name="tabIndicatorColor">@color/ds_accent_primary</item>
        <item name="tabRippleColor">@color/ds_accent_primary_alpha</item>
    </style>
    <style name="Widget.AiVideoTest.ActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="background">@color/ds_background_primary</item>
        <item name="titleTextStyle">@style/TextAppearance.AiVideoTest.Title3.Emphasized</item>
        <item name="subtitleTextStyle">@style/TextAppearance.AiVideoTest.Subheadline.Regular</item>
    </style>
    <style name="Widget.AiVideoTest.MenuText" parent="Widget.AiVideoTest.TextView">
        <item name="android:textAppearance">@style/TextAppearance.AiVideoTest.Subheadline.Regular</item>
    </style>
</resources>
