    <com.google.android.material.textview.MaterialTextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textAppearance="@style/TextAppearance.AiVideoTest.Title3.Emphasized" android:maxLines="1" android:ellipsize="end" />
    <com.google.android.material.button.MaterialButton android:id="@+id/balance" style="@style/Widget.AiVideoTest.Button.Secondary" android:layout_width="wrap_content" android:layout_height="44dp" android:minWidth="64dp" android:textColor="@color/ds_accent_primary" />
</LinearLayout>
