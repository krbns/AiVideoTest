<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="24dp">
    <com.google.android.material.card.MaterialCardView android:id="@+id/promptCard" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="32dp" app:strokeWidth="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <com.google.android.material.textview.MaterialTextView android:id="@+id/editorHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/describe_idea" android:textAppearance="@style/TextAppearance.AiVideoTest.Title3.Emphasized" android:textColor="@color/ds_accent_primary" />
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/promptInput" android:layout_width="match_parent" android:layout_height="220dp" android:background="@null" android:gravity="top|start" android:padding="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:layout_marginTop="12dp" android:hint="@string/prompt_hint" android:inputType="textMultiLine|textCapSentences" android:textAppearance="@style/TextAppearance.AiVideoTest.Subheadline.Regular" android:scrollbars="vertical" android:saveEnabled="false" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:gravity="center_vertical">
                <com.google.android.material.card.MaterialCardView android:id="@+id/photoCard" android:layout_width="64dp" android:layout_height="64dp" app:cardCornerRadius="20dp" app:strokeWidth="0dp" android:clickable="true" android:focusable="true" android:contentDescription="@string/choose_photo">
                    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                        <ImageView android:id="@+id/photoPreview" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="18dp" android:scaleType="centerCrop" android:src="@drawable/ic_photo" android:importantForAccessibility="no" />
                        <ProgressBar android:id="@+id/photoProgress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:visibility="gone" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButton android:id="@+id/removePhoto" style="@style/Widget.AiVideoTest.Button.Text" android:layout_width="48dp" android:layout_height="48dp" android:padding="0dp" android:minWidth="0dp" android:text="@string/remove_symbol" android:contentDescription="@string/remove_photo" />
                <com.google.android.material.button.MaterialButton android:id="@+id/copyPrompt" style="@style/Widget.AiVideoTest.Button.Secondary" android:layout_width="64dp" android:layout_height="48dp" android:padding="0dp" android:minWidth="0dp" android:text="@string/copy" />
                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center">
                    <com.google.android.material.button.MaterialButton android:id="@+id/clearPrompt" style="@style/Widget.AiVideoTest.Button.Text" android:layout_width="48dp" android:layout_height="40dp" android:padding="0dp" android:minWidth="0dp" android:text="@string/remove_symbol" android:contentDescription="@string/clear_prompt" />
                    <com.google.android.material.textview.MaterialTextView android:id="@+id/counter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.AiVideoTest.Caption1.Regular" android:textColor="@color/ds_label_tertiary" android:accessibilityLiveRegion="polite" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.textview.MaterialTextView android:id="@+id/error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/ds_accent_red" android:textAppearance="@style/TextAppearance.AiVideoTest.Caption1.Regular" android:visibility="gone" android:accessibilityLiveRegion="polite" />
    <LinearLayout android:id="@+id/photoRecovery" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
        <com.google.android.material.button.MaterialButton android:id="@+id/retryPhoto" style="@style/Widget.AiVideoTest.Button.Text" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/retry" />
        <com.google.android.material.button.MaterialButton android:id="@+id/chooseAnother" style="@style/Widget.AiVideoTest.Button.Text" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/choose_another" />
    </LinearLayout>
    <LinearLayout android:id="@+id/resolutionGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="20dp">
        <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/resolutions" android:textAppearance="@style/TextAppearance.AiVideoTest.Headline.Emphasized" />
        <LinearLayout android:id="@+id/resolutionOptions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" />
    </LinearLayout>
    <LinearLayout android:id="@+id/styleGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="20dp">
        <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/select_style" android:textAppearance="@style/TextAppearance.AiVideoTest.Headline.Emphasized" />
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
            <LinearLayout android:id="@+id/styleOptions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="12dp" />
        </HorizontalScrollView>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/generate" android:textColor="@color/ds_generate_content" style="@style/Widget.AiVideoTest.Button.Primary" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="28dp" android:text="@string/generate" android:enabled="false" />
    <com.google.android.material.textview.MaterialTextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginTop="10dp" android:text="@string/demo_generation_note" android:textAppearance="@style/TextAppearance.AiVideoTest.Caption1.Regular" android:textColor="@color/ds_label_tertiary" />
</LinearLayout>
